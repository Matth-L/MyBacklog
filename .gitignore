# --- User data (never versioned — created at runtime, per-install) ---
/data/
/backup_backlog/
/cover_art/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Logs ---
*.log

# --- Editors / IDEs ---
.vscode/
*.swp
*.swo

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Env / secrets (API keys live in data/config.json, already ignored above,
# but ignore any .env files too in case that pattern is ever used) ---
.env
.env.*
.venv
